PORT=3003
DATABASE_URL=postgresql://hotel:hotel@localhost:5432/auth_db
# Même valeur dans tous les services. Générer avec : openssl rand -hex 32
CLE_INTERNE=a-remplacer
# Clé PRIVÉE donnée par : pnpm --filter @hotel/auth generer-cles (secret, ne jamais commiter)
JWT_CLE_PRIVEE=a-remplacer
# Chemin du cookie de session vu par le navigateur (derrière la gateway)
COOKIE_CHEMIN=/api/auth
