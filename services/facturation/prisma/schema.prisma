generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Règle : une valeur d'enum par ligne, toujours.
// Une valeur écrite sur la même ligne que « { » est IGNORÉE par Prisma, sans erreur
// (c'est ainsi que SEJOUR et MVOLA avaient disparu de la base en phase 1).
enum TypeFacture {
  SEJOUR
  RESTAURANT
}

enum StatutFacture {
  EMISE
  PAYEE
  CLOTUREE
  ANNULEE
}

// Propriétaire de l'argent : le lieu de paiement change, le propriétaire non.
enum Origine {
  HEBERGEMENT
  RESTAURANT
  LIVRAISON
}

enum StatutPaiement {
  EN_ATTENTE
  REUSSI
  ECHOUE
  // Ajout au modèle : argent reçu mais incohérent (montant différent, facture déjà soldée,
  // paiement arrivé sur un lien remplacé). À traiter à la main (remboursement).
  ANOMALIE
  // Anomalie traitée : l'argent a été rendu au client (dans le tableau de bord Papi).
  REMBOURSE
}

enum MethodePaiement {
  ESPECES
  MVOLA
  ORANGE_MONEY
  AIRTEL_MONEY
  CARTE
}

enum Langue {
  FR
  MG
  EN
}

model Facture {
  id             String        @id @default(uuid()) @db.Uuid
  // Séquentiel et sans trou : FAC-2026-000123 (compteur_facture, même transaction)
  numero         String        @unique
  type           TypeFacture
  reservationId  String?       @unique @map("reservation_id") @db.Uuid // hebergement, sans FK
  commandeId     String?       @unique @map("commande_id") @db.Uuid // restaurant, sans FK
  // Ajout au modèle : le compte du client (auth, sans FK), pour qu'il ne voie et ne paie QUE ses factures
  clientId       String?       @map("client_id") @db.Uuid
  clientNom      String        @map("client_nom") // snapshot
  // Snapshots pour le reçu (email) et le paiement mobile (téléphone)
  clientEmail    String?       @map("client_email")
  clientTelephone String?      @map("client_telephone")
  langue         Langue        @default(FR)
  statut         StatutFacture @default(EMISE) // une facture émise ne se supprime jamais
  montantTotal   Int           @map("montant_total")
  montantPaye    Int           @default(0) @map("montant_paye")
  emiseLe        DateTime      @default(now()) @map("emise_le") @db.Timestamptz
  clotureeLe     DateTime?     @map("cloturee_le") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  lignes    LigneFacture[]
  paiements Paiement[]

  @@index([clientId])
  @@index([statut])
  @@map("facture")
}

model LigneFacture {
  id           String  @id @default(uuid()) @db.Uuid
  factureId    String  @map("facture_id") @db.Uuid
  libelle      String // ex. Suite Prestige – 3 nuits
  quantite     Int
  prixUnitaire Int     @map("prix_unitaire")
  montant      Int
  origine      Origine
  sourceId     String  @map("source_id") @db.Uuid // reservation_id ou commande_id
  // Rang de la ligne pour une même source : un séjour a une ligne par groupe de nuitées (0, 1, 2…),
  // une commande restaurant a toujours une seule ligne (0).
  ordre        Int     @default(0)

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  // Une même ligne n'est jamais facturée deux fois (idempotence de consommation.imputee : ordre 0)
  @@unique([origine, sourceId, ordre])
  @@map("ligne_facture")
}

model Paiement {
  id                    String           @id @default(uuid()) @db.Uuid // = "reference" envoyée à Papi
  factureId             String           @map("facture_id") @db.Uuid
  montant               Int
  // Montant annoncé par Papi, gardé en cas d'ANOMALIE : c'est ce qu'il faudra peut-être rembourser
  montantRecu           Int?             @map("montant_recu")
  statut                StatutPaiement   @default(EN_ATTENTE)
  // Inconnue tant que Papi n'a pas dit comment le client a payé
  methode               MethodePaiement?
  referenceExterne      String?          @unique @map("reference_externe") // paymentReference de Papi
  encaissePar           String?          @map("encaisse_par") @db.Uuid // auth, sans FK (espèces)
  // Ajouts au modèle, exigés par la sécurité Papi (énoncé) : on ne stocke que des EMPREINTES
  jetonHash             String?          @map("jeton_hash") // SHA-256 du jeton placé dans notificationUrl
  notificationTokenHash String?          @map("notification_token_hash") // SHA-256 du notificationToken de Papi
  urlPaiement           String?          @map("url_paiement")
  erreur                String?
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  // Le client est revenu de Papi avec ce lien (page de retour) : le lien est peut-être consommé,
  // on ne le réutilise plus. Ce n'est JAMAIS une preuve de paiement (seule la notification l'est).
  visiteLe              DateTime?        @map("visite_le") @db.Timestamptz
  // Traitement d'une ANOMALIE par le comptable : qui, quand, pourquoi (remboursé ou accepté)
  traiteLe              DateTime?        @map("traite_le") @db.Timestamptz
  traitePar             String?          @map("traite_par") @db.Uuid // auth, sans FK
  commentaire           String?

  facture Facture @relation(fields: [factureId], references: [id])

  @@index([factureId])
  @@map("paiement")
}

model CompteurFacture {
  annee         Int @id
  dernierNumero Int @map("dernier_numero")

  @@map("compteur_facture")
}

// ---------------------------------------------------------------------------
// Tables techniques (docs/modele-donnees.md, « Mécanismes communs »)
// ---------------------------------------------------------------------------

model OutboxEvenement {
  id        String    @id @default(uuid()) @db.Uuid
  type      String
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publieLe  DateTime? @map("publie_le") @db.Timestamptz

  @@index([publieLe, createdAt])
  @@map("outbox_evenement")
}

model EvenementTraite {
  evenementId String   @id @map("evenement_id") @db.Uuid
  traiteLe    DateTime @default(now()) @map("traite_le") @db.Timestamptz

  @@map("evenement_traite")
}
